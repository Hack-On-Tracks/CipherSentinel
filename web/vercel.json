{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": {
      "description": "URL of the FastAPI backend (e.g. https://ciphersentinel-api.onrender.com)"
    }
  }
}
